# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL — same database as the Node API. SQLAlchemy uses the psycopg v3
# driver, so the URL scheme is postgresql+psycopg.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_orchestrator

# Internal URL of the Node API service (for callbacks / webhooks later).
API_URL=http://localhost:4000

# Redis connection (used by the pipeline queue in a later phase).
REDIS_URL=redis://localhost:6379

# Shared secret authenticating internal calls to the Node API (must match api/.env).
INTERNAL_SECRET=change-me
