# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# CORS — comma-separated list of allowed origins (the frontend URL)
CORS_ORIGINS=http://localhost:3000

# Clerk backend keys — get these from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key

# PostgreSQL connection string (must have the pgvector extension available)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_orchestrator?schema=public

# AES-256 key for encrypting provider API keys — 32 bytes, hex-encoded.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Shared secret authenticating internal calls from the Python orchestrator.
# Generate with: openssl rand -hex 24 (must match orchestrator/.env)
INTERNAL_SECRET=

# Base URL of the Python orchestration engine.
ORCHESTRATOR_URL=http://localhost:8000

# Managed-tier platform keys (optional). Set any you want the platform to supply
# so users can run pipelines without their own keys. Fund ≥2 providers to enable
# real multi-model routing. BYOK keys (added per-user) always take precedence.
MANAGED_OPENAI_KEY=
MANAGED_ANTHROPIC_KEY=
MANAGED_GEMINI_KEY=
MANAGED_DEEPSEEK_KEY=
