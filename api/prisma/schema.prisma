// Prisma schema for AI Orchestrator.
// pgvector is enabled via the `postgresqlExtensions` preview feature so the
// cross-project memory embeddings can live directly in PostgreSQL.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Provider {
  openai
  anthropic
  gemini
  deepseek
}

enum ProjectStatus {
  draft
  running
  paused
  completed
  failed
}

enum TaskStatus {
  pending
  running
  completed
  failed
  skipped
}

enum CheckpointStatus {
  pending
  approved
  rejected
}

enum MemoryType {
  writing_style
  tech_stack
  audience
  tone
  general
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique @map("clerk_id")
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  providerKeys ProviderKey[]
  projects     Project[]
  memories     UserMemory[]

  @@map("users")
}

model ProviderKey {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  provider      Provider
  // Null when isManagedMode is true (the platform supplies the key instead).
  encryptedKey  String?  @map("encrypted_key")
  isManagedMode Boolean  @default(false) @map("is_managed_mode")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("provider_keys")
}

model Project {
  id                   String        @id @default(cuid())
  userId               String        @map("user_id")
  name                 String
  goal                 String
  orchestratorProvider Provider      @map("orchestrator_provider")
  orchestratorModel    String        @map("orchestrator_model")
  status               ProjectStatus @default(draft)
  // The clean, user-facing deliverable composed after all tasks complete.
  finalOutput          String?       @map("final_output")
  createdAt            DateTime      @default(now()) @map("created_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  checkpoints Checkpoint[]
  files       WorkspaceFile[]

  @@index([userId])
  @@map("projects")
}

model Task {
  id               String     @id @default(cuid())
  projectId        String     @map("project_id")
  sequenceOrder    Int        @map("sequence_order")
  title            String
  instruction      String
  assignedProvider Provider?  @map("assigned_provider")
  assignedModel    String?    @map("assigned_model")
  status           TaskStatus @default(pending)
  output           String?
  tokensUsed       Int        @default(0) @map("tokens_used")
  createdAt        DateTime   @default(now()) @map("created_at")
  completedAt      DateTime?  @map("completed_at")

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkpoints Checkpoint[]
  files       WorkspaceFile[]

  @@unique([projectId, sequenceOrder])
  @@index([projectId])
  @@map("tasks")
}

model Checkpoint {
  id        String           @id @default(cuid())
  projectId String           @map("project_id")
  taskId    String           @map("task_id")
  status    CheckpointStatus @default(pending)
  userNotes String?          @map("user_notes")
  createdAt DateTime         @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([taskId])
  @@map("checkpoints")
}

model WorkspaceFile {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  taskId    String?  @map("task_id")
  filename  String
  fileType  String   @map("file_type")
  r2Key     String   @map("r2_key")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("workspace_files")
}

model UserMemory {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  memoryType MemoryType @default(general) @map("memory_type")
  content    String
  // pgvector column. Prisma has no native vector type, so it is declared as
  // Unsupported — reads/writes of the embedding go through raw queries.
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_memory")
}
